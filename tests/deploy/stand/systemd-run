#!/bin/bash
# systemd-run with one injected answer (PRESET-09a acceptance matrix).
#
# On the stand ~/bin comes first in PATH for SSH commands, so deploy.sh's
# launch goes through here. ~/faults/systemd-run names the fault; it fires
# once and removes itself:
#   refuse      nothing is started, an error is returned (R106)
#   lost-reply  the unit is started, an error is returned anyway (R102)
fault="$(cat "$HOME/faults/systemd-run" 2>/dev/null || true)"
case "$fault" in
  refuse)
    rm -f "$HOME/faults/systemd-run"
    echo "systemd-run-fault: refused, nothing started" >&2
    exit 1 ;;
  lost-reply)
    rm -f "$HOME/faults/systemd-run"
    /usr/bin/systemd-run "$@" >/dev/null 2>&1
    echo "systemd-run-fault: started, reply lost" >&2
    exit 1 ;;
esac
exec /usr/bin/systemd-run "$@"
