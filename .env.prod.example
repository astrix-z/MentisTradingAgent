# Шаблон боевого окружения Mentis Trading Agent (сервер 192.168.55.40).
# Скопировать на сервер в ~/apps/mentis-trading-agent/.env.prod (chmod 600) и
# заполнить реальные значения. Файл в git НЕ попадает (секреты — только здесь
# на сервере и в .env машины разработки). deploy.sh его никогда не трогает.

# --- Приложение ---
ENVIRONMENT=production
PROJECT_NAME=Mentis Trading Agent
LOG_LEVEL=INFO

# Порт/адрес, на котором backend слушает на хосте. WEB_BIND=0.0.0.0 — доступ
# из локальной сети 192.168.55.0/24 напрямую: http://192.168.55.40:8010.
# В интернет НЕ смотрит: firewalld на 55.40 пропускает 8010/tcp только с
# 192.168.55.0/24 (rich rule, см. docs/DEPLOY.md §1 и §3). Если понадобится
# сузить обратно до одной машины — верните WEB_BIND=127.0.0.1 и используйте
# SSH-туннель: ssh -L 8010:localhost:8010 jb@192.168.55.40
# Порт должен быть свободен на 55.40 (там живут другие контейнеры — см.
# docs/DEPLOY.md).
WEB_PORT=8010
WEB_BIND=0.0.0.0
WEB_HOST=192.168.55.40
ADMINER_PORT=8011

# --- Секреты приложения ---
# SECRET_KEY сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=<сгенерировать>
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=<сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(24))">

# --- База данных ---
# Контейнер postgres:18 внутри стека (сервис db), порт наружу не публикуется
# (5432 на хосте и так занят чужим postgres-shared). backend/agent находят
# базу по имени сервиса db — не менять.
POSTGRES_PASSWORD=<сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(24))">

# --- Email (SMTP) --- оставить пустым, если не нужен
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# --- Binance: live-ключ ---
# Перенесён из .env машины разработки при переезде на этот хост. После
# переноса тот же ключ НЕ должен одновременно использоваться локальным
# стендом (риск задвоенных ордеров) — см. docs/DEPLOY.md.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Binance: testnet (опционально) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Agent: внешняя read-only БД рыночных данных (опционально) ---
BINANCE_DB_URL=

# --- Observability ---
SENTRY_DSN=
