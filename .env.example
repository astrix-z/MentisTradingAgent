# Copy this file to `.env` and fill in real values.
# The tracked `.env` keeps local development defaults; `.env.example` is the reference template.
# Hostnames here use `localhost` for processes run on the host. Docker Compose
# overrides service hostnames (db, mailpit, etc.) to the Compose service names.

# --- Project ---
PROJECT_NAME=Mentis Trading Agent
SECRET_KEY=changethis
FASTAPI_ENV=development
DOMAIN=localhost
ENVIRONMENT=development

# --- Backend / Auth ---
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# --- Postgres (db service) ---
POSTGRES_PASSWORD=changethis
# Database connection used by the FastAPI backend (the `app` database).
DATABASE_URL=postgresql://postgres:changethis@localhost:5432/app

# --- Agent: own settings DB (dedicated `agent` database on the same Postgres) ---
AGENT_DB_URL=postgresql://postgres:changethis@localhost:5432/agent

# --- Agent: Binance read-only market DB (use a SELECT-only role) ---
BINANCE_DB_URL=

# --- Agent: Binance credentials ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Agent: Binance testnet (sandbox) credentials ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Email (SMTP) ---
# Leave SMTP_HOST empty to disable emails. For local dev the override stack
# points the backend at the `mailpit` service.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=

# --- Observability ---
SENTRY_DSN=
